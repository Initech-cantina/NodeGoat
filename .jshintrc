{
    "node": true,
    "browser": true,
    "esversion": 9,
    "bitwise": false,
    "camelcase": true,
    "curly": false,
    "eqeqeq": true,
    "immed": true,
    "latedef": true,
    "newcap": true,
    "noarg": true,
    "quotmark": "double",
    "regexp": true,
    "undef": true,
    "unused": false,
    "strict": true,
    "trailing": true,
    "smarttabs": false,
    "indent": 4,
    "maxlen": 120,
    "devel": false,
    "noempty": true,
    "overrides": {
        "test/e2e/**": {
            "globals": {
                "cy": false,
                "Cypress": false,
                "it": false,
                "describe": false,
                "before": false,
                "after": false,
                "beforeEach": false,
                "afterEach": false,
                "expect": false
            }
        },
        "test/security/memos-xss-test.js": {
            "globals": {
                "describe": false,
                "it": false,
                "before": false,
                "after": false,
                "beforeEach": false,
                "afterEach": false
            },
            "scripturl": true
        }
    }
}
